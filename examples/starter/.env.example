# Placeholders only. Copy to .env.local and fill in real values locally; never commit them.
# No accounts (hosting, database, email, payments, error tracking) are linked in this starter,
# so every variable below stays empty until you create the account.
# scripts/check-project-profile.ts rejects any value here that is not empty or a URL.

# Supabase (database and auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only: used by the content-acceptance routes
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to accept copy
ADMIN_EMAILS=
# Set to "hard" to block deploys while copy is unaccepted
CONTENT_ACCEPTANCE_GATE=

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (optional)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Resend (optional)
RESEND_API_KEY=
