{
  "name": "canon-starter",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:visual": "bash scripts/visual.sh",
    "test:visual:update": "bash scripts/visual.sh --update",
    "email:dev": "email dev",
    "gen:types": "supabase gen types typescript --linked > src/types/database.ts",
    "prepare": "husky",
    "lint:content": "bun scripts/lint-content.ts",
    "content:report": "bun scripts/content-report.ts",
    "lint:literals": "bun scripts/lint-literals.ts",
    "spellcheck": "cspell lint --no-must-find-files '**/*.{md,mdx,ts,tsx}'",
    "check:enforcement": "bun scripts/check-enforcement.ts",
    "check:profile": "bun scripts/check-project-profile.ts",
    "check:file-length": "bun scripts/check-file-length.ts",
    "check:api-messages": "bun scripts/check-api-messages.ts",
    "check:ds": "bun scripts/check-design-system.ts --all && bun scripts/check-ds-coverage.ts && bun scripts/check-ds-page.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "feedtack": "^0.3.0",
    "lucide-react": "^1.8.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.4",
    "posthog-js": "^1.200.0",
    "posthog-node": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.1.0",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "1.64.0",
    "@react-email/components": "^0.0.28",
    "@sentry/nextjs": "^8.45.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "cspell": "^10.0.0",
    "husky": "^9.1.0",
    "jsdom": "^29.0.0",
    "lint-staged": "^15.2.0",
    "playwright": "1.64.0",
    "react-email": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css}": "biome check --write --no-errors-on-unmatched",
    "*.{ts,tsx}": [
      "bun scripts/check-no-emoji.ts",
      "bun scripts/lint-literals.ts",
      "bash scripts/tsc-staged.sh"
    ],
    "*.{jsx,tsx}": "bun scripts/check-design-system.ts --staged-only",
    "src/components/ui/**": [
      "bun scripts/check-ds-coverage.ts",
      "bun scripts/check-ds-page.ts"
    ],
    "src/app/design-system/**": "bun scripts/check-ds-page.ts",
    "{ENFORCEMENT,CLAUDE}.md": "bun scripts/check-enforcement.ts",
    "*.{md,mdx}": "cspell lint --no-must-find-files",
    "{project-profile.json,.env.example,package.json}": "bun scripts/check-project-profile.ts",
    "*.{ts,tsx,js,jsx,mjs,cjs,sh,css}": "bun scripts/check-file-length.ts",
    "src/**/*.{ts,tsx}": "bun scripts/check-api-messages.ts"
  }
}
